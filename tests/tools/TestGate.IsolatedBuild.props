<Project>
  <PropertyGroup Condition="'$(PreflightOutputRoot)' != ''">
    <BaseOutputPath>$(PreflightOutputRoot)\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(PreflightOutputRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(PreflightOutputRoot)\obj\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
    <NuGetLockFilePath>$(PreflightOutputRoot)\obj\$(MSBuildProjectName)\packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="Exists('$(MSBuildProjectDirectory)\packages.lock.json')">true</RestoreLockedMode>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <Target Name="TestGateCopyLockedPackageFile"
          BeforeTargets="Restore"
          Condition="'$(PreflightOutputRoot)' != '' and Exists('$(MSBuildProjectDirectory)\packages.lock.json')">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(NuGetLockFilePath)'))" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\packages.lock.json"
          DestinationFiles="$(NuGetLockFilePath)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
